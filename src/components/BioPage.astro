---
import { BRANDS, type Brand } from '../data/brands';
import { loadFanlinkPage, avatarUrl, embedInfo, type FanlinkLink } from '../lib/fanlink';
import SocialIcon from './SocialIcon.astro';
import LinkCard from './LinkCard.astro';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
const config = BRANDS[brand];
const data = await loadFanlinkPage(brand);

// Cache curto na CDN: mudou no Center, o link atualiza em ~1 min.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600',
);

const nome = data?.profile.display_name ?? config.name;
const avatar = avatarUrl(data?.profile.avatar_path ?? null);
const socialsNoTopo = data?.profile.social_position === 'top';
const descricao = data?.profile.bio ?? `Todos os links de ${nome} em um só lugar.`;

const renderaveis = (l: FanlinkLink) => ({ link: l, player: l.embed ? embedInfo(l.url) : null });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${nome} | Links`}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={config.host} />
    <link rel="icon" type="image/png" href={`/favicon-${brand}.png`} />
    <link rel="apple-touch-icon" href={`/favicon-${brand}.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={config.fontHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nome} />
    <meta property="og:title" content={`${nome} | Links`} />
    <meta property="og:description" content={descricao} />
    {avatar && <meta property="og:image" content={avatar} />}
    <meta property="og:url" content={config.host} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content={config.bg} />
  </head>
  <body
    class:list={[{ caps: config.uppercaseName }]}
    style={`--accent: ${config.accent}; --bg: ${config.bg}; --fdisplay: ${config.displayFont};`}
  >
    <div class="glow" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>
    <main>
      <header class="perfil">
        {avatar && <img class="avatar" src={avatar} alt={`Foto de ${nome}`} width="192" height="192" />}
        <h1>{nome}</h1>
        {data?.profile.bio && <p class="bio">{data.profile.bio}</p>}
      </header>

      {data && data.socials.length > 0 && socialsNoTopo && (
        <nav class="sociais" aria-label="Redes sociais">
          {data.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.network} title={s.network}>
              <SocialIcon network={s.network} />
            </a>
          ))}
        </nav>
      )}

      {!data && <p class="vazio">Página em construção.</p>}

      {data && (
        <div class="blocos">
          {data.blocks.map((b) =>
            b.kind === 'link' ? (
              <LinkCard {...renderaveis(b.link)} />
            ) : (
              <section class="secao">
                {b.section.title && <h2>{b.section.title}</h2>}
                {b.section.layout === 'carousel' ? (
                  <div class="carrossel">
                    {b.section.links.map((l) => (
                      <a class="cartao" href={l.url} target="_blank" rel="noopener">
                        {l.thumb_url ? (
                          <img src={l.thumb_url} alt="" width="300" height="300" loading="lazy" referrerpolicy="no-referrer" />
                        ) : (
                          <span class="ph" aria-hidden="true"></span>
                        )}
                        <span class="titulo">{l.title}</span>
                      </a>
                    ))}
                  </div>
                ) : b.section.layout === 'music' ? (
                  <div class="grade">
                    {b.section.links.map((l) => (
                      <a class="cartao" href={l.url} target="_blank" rel="noopener">
                        {l.thumb_url ? (
                          <img src={l.thumb_url} alt="" width="300" height="300" loading="lazy" referrerpolicy="no-referrer" />
                        ) : (
                          <span class="ph" aria-hidden="true"></span>
                        )}
                        <span class="titulo">{l.title}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  b.section.links.map((l) => <LinkCard {...renderaveis(l)} />)
                )}
              </section>
            ),
          )}
        </div>
      )}

      {data && data.socials.length > 0 && !socialsNoTopo && (
        <nav class="sociais rodape" aria-label="Redes sociais">
          {data.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.network} title={s.network}>
              <SocialIcon network={s.network} />
            </a>
          ))}
        </nav>
      )}
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    color-scheme: dark;
  }
  body {
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg);
    color: #fff;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .glow {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(60% 40% at 50% -10%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 70%),
      radial-gradient(50% 30% at 50% 115%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  /* Grão sutil por cima de tudo — o toque analógico do dark premium */
  .noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.05;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.7'/></svg>");
  }
  main {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 16px calc(40px + env(safe-area-inset-bottom));
  }
  .perfil {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.5),
      0 0 40px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  /* O nome usa o mesmo tratamento dos títulos de seção que o Lester
     aprovou: Unbounded, caixa alta, tracking generoso. */
  h1 {
    font-family: var(--fdisplay);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  body.caps h1 {
    text-transform: uppercase;
  }
  .bio {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    max-width: 44ch;
  }
  .sociais {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }
  .sociais a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .sociais a:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }
  .sociais :global(svg) {
    width: 20px;
    height: 20px;
    fill: rgba(255, 255, 255, 0.85);
  }
  .sociais a:hover :global(svg) {
    fill: var(--accent);
  }
  .blocos {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .secao {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }
  /* Sem os traços laterais (feedback do Lester) — só a fonte falando */
  .secao h2 {
    font-family: var(--fdisplay);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--accent) 75%, #fff 25%);
    text-align: center;
    margin-top: 8px;
  }

  /* ---- Seção CARROSSEL (estilo Komi): rolagem horizontal com snap ---- */
  .carrossel {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px 10px;
    scrollbar-width: none;
  }
  .carrossel::-webkit-scrollbar {
    display: none;
  }
  .carrossel .cartao {
    flex: 0 0 148px;
    scroll-snap-align: start;
  }

  /* ---- Seção GRADE MUSICAL: capas em 2 colunas ---- */
  .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .cartao {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #fff;
    text-decoration: none;
  }
  .cartao img,
  .cartao .ph {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    background: #151515;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cartao:hover img,
  .cartao:hover .ph {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .cartao .titulo {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .vazio {
    margin-top: 40px;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
  }
  .sociais.rodape {
    margin-top: 34px;
    padding-bottom: 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sociais a,
    .cartao img,
    .cartao .ph {
      transition: none;
    }
    .sociais a:hover,
    .cartao:hover img,
    .cartao:hover .ph {
      transform: none;
    }
  }
</style>
