---
import { BRANDS } from '../data/brands';
import { SERVICE_LABELS, SERVICE_ORDER } from '../data/releases';
import type { Release } from '../data/releases';

interface Props {
  release: Release;
}

const { release } = Astro.props;
const brand = BRANDS[release.brand];
const canonical = `${brand.host}/${release.slug}`;
const coverAbs = `${brand.host}${release.cover}`;
const services = SERVICE_ORDER.filter((s) => release.links[s]);
const pageTitle = `${release.artist} — ${release.title}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={`Ouça ${release.title} de ${release.artist} na sua plataforma preferida.`}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="music.song" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Ouça agora em todas as plataformas" />
    <meta property="og:image" content={coverAbs} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={brand.bg} />
  </head>
  <body style={`--accent: ${brand.accent}; --bg: ${brand.bg};`}>
    <div class="backdrop" style={`background-image: url('${release.cover}');`}></div>
    <main>
      <article class="card">
        <img
          class="cover"
          src={release.cover}
          alt={`Capa de ${release.title}`}
          width="640"
          height="640"
        />
        <h1>{release.title}</h1>
        <p class="artist">{release.artist}</p>
        <nav class="links" aria-label="Plataformas">
          {services.map((s) => (
            <a class="service" href={release.links[s]} target="_blank" rel="noopener">
              <span class="name">{SERVICE_LABELS[s]}</span>
              <span class="cta">Ouvir</span>
            </a>
          ))}
        </nav>
        <footer>{brand.name}</footer>
      </article>
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    color-scheme: dark;
  }
  body {
    min-height: 100vh;
    background: var(--bg);
    color: #fff;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .backdrop {
    position: fixed;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(48px) saturate(1.2) brightness(0.45);
    transform: scale(1.15);
    z-index: 0;
  }
  main {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
  }
  .card {
    width: 100%;
    max-width: 420px;
    background: rgba(12, 12, 16, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    padding: 24px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }
  h1 {
    margin-top: 20px;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .artist {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
  }
  .links {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .service {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }
  .service:hover {
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }
  .service .cta {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  footer {
    margin-top: 22px;
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
