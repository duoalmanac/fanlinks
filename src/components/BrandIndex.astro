---
import { BRANDS } from '../data/brands';
import { releases } from '../data/releases';
import type { Brand } from '../data/releases';

interface Props {
  brandKey: Brand;
}

const { brandKey } = Astro.props;
const brand = BRANDS[brandKey];
const list = releases.filter((r) => r.brand === brandKey);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brand.name} — Links</title>
    <meta name="description" content={`Todos os lançamentos de ${brand.name}.`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={`${brand.name} — Links`} />
    <meta property="og:url" content={brand.host} />
    <meta name="theme-color" content={brand.bg} />
  </head>
  <body style={`--accent: ${brand.accent}; --bg: ${brand.bg};`}>
    <main>
      <h1>{brand.name}</h1>
      <p class="sub">Lançamentos</p>
      <div class="grid">
        {list.map((r) => (
          <a class="release" href={`./${r.slug}`}>
            <img src={r.cover} alt={`Capa de ${r.title}`} width="320" height="320" loading="lazy" />
            <span class="title">{r.title}</span>
            <span class="artist">{r.artist}</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    color-scheme: dark;
  }
  body {
    min-height: 100vh;
    background: var(--bg);
    color: #fff;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 20px;
  }
  h1 {
    font-size: 1.6rem;
    letter-spacing: -0.01em;
  }
  .sub {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.95rem;
  }
  .grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 18px;
  }
  .release {
    color: #fff;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .release img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .release:hover img {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .title {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .artist {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.8rem;
  }
</style>
