---
import {
  siInstagram,
  siTiktok,
  siYoutube,
  siSpotify,
  siSoundcloud,
  siTwitch,
  siDiscord,
  siX,
  siWhatsapp,
  siThreads,
  siFacebook,
  siTelegram,
} from 'simple-icons';

interface Props {
  network: string;
}

const ICONES: Record<string, { path: string; title: string }> = {
  instagram: siInstagram,
  tiktok: siTiktok,
  youtube: siYoutube,
  spotify: siSpotify,
  soundcloud: siSoundcloud,
  twitch: siTwitch,
  discord: siDiscord,
  x: siX,
  twitter: siX,
  whatsapp: siWhatsapp,
  threads: siThreads,
  facebook: siFacebook,
  telegram: siTelegram,
};

const { network } = Astro.props;
const chave = network.toLowerCase();
const icone = ICONES[chave] ?? null;
const isEmail = chave === 'email' || chave === 'e-mail';
---

{icone ? (
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icone.path}></path></svg>
) : isEmail ? (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M1.5 4.5h21c.83 0 1.5.67 1.5 1.5v12c0 .83-.67 1.5-1.5 1.5h-21C.67 19.5 0 18.83 0 18V6c0-.83.67-1.5 1.5-1.5zm10.5 8.25L2.25 6.375v11.25h19.5V6.375L12 12.75z"></path>
  </svg>
) : (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm-1 4v5.41l3.3 3.3 1.4-1.42L13 12.6V8h-2z"></path>
  </svg>
)}
